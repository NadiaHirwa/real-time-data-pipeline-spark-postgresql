# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_events
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password

# Pipeline paths (relative to project root)
INCOMING_DIR=data/incoming
ARCHIVE_DIR=data/processed_archive
REJECTED_DIR=data/rejected
CHECKPOINT_DIR=checkpoint
LOG_DIR=logs

# Spark streaming tuning
MAX_FILES_PER_TRIGGER=5
TRIGGER_INTERVAL_SECONDS=5

# Data generator tuning
GENERATOR_INTERVAL_SECONDS=3
GENERATOR_EVENTS_PER_FILE=20
